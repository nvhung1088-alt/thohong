{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/index.html"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "server.js"
    },
    {
      "src": "/rss.xml",
      "dest": "server.js"
    },
    {
      "src": "/blog",
      "dest": "/public/index.html"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/san-pham/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/danh-muc/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/dia-chi",
      "dest": "/public/index.html"
    },
    {
      "src": "/lien-he",
      "dest": "/public/index.html"
    },
    {
      "src": "/product-category/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/product-tag/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/product/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/category/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/tag/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/cua-hang(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/pos/sync",
      "schedule": "0 0 * * *"
    }
  ]
}